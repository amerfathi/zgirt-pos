{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "/atomicStore.js": ["./src/services/atomicStore.js"],
      "/durableAggregate.js": ["./src/services/durableAggregate.js"],
      "/cashDrawerJournal.js": ["./src/services/cashDrawerJournal.js"],
      "/reviewLedgerReplay.js": ["./src/services/reviewLedgerReplay.js"],
      "/offlineGrantStore.js": ["./src/services/offlineGrantStore.js"],
      "/offlineDeviceIdentity.js": ["./src/services/offlineDeviceIdentity.js"],
      "/tenantStorage.js": ["./src/services/tenantStorage.js"]
    },
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "strict": false
  },
  "include": ["src/**/*", "functions/**/*", "electron/**/*", "scripts/**/*", "tests/**/*", "vite.config.js", "capacitor.config.*"]
}
